{
  "name": "@reins/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:coverage": "vitest run --configLoader native --pool=threads --maxWorkers=1 --coverage --coverage.include=src/**/*.{ts,tsx} --coverage.exclude=src/lib/auth-client.ts --coverage.exclude=src/lib/stripe-payment-provider.ts --coverage.exclude=src/lib/stripe-test-execution.ts --coverage.exclude=src/lib/stripe-webhook.ts --coverage.exclude=src/app/assurance/graph.tsx --coverage.exclude=src/app/assurance/policy-draft.tsx --coverage.exclude=src/app/assurance/simulation-studio.tsx --coverage.exclude=src/app/assurance/command-center.tsx --coverage.exclude=src/app/assurance/task-control-room.tsx --coverage.exclude=src/app/assurance/control-room.tsx --coverage.exclude=src/app/api/policy-draft/route.ts --coverage.exclude=src/app/api/simulation/route.ts --coverage.exclude=src/app/api/provider-executions/stripe-test/route.ts --coverage.exclude=src/app/api/webhooks/stripe/route.ts --coverage.reporter=text --coverage.reporter=json-summary --coverage.reportsDirectory=../../coverage/web --coverage.thresholds.statements=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.lines=90",
    "test:integration": "vitest run src/app/api/auth/[...all]/route.integration.test.ts src/app/api/assessments/route.integration.test.ts --configLoader native --pool=threads --maxWorkers=1",
    "test:unit": "vitest run --configLoader native --pool=threads --maxWorkers=1 --exclude \"**/*.integration.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@reins/assurance": "workspace:*",
    "@reins/db": "workspace:*",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^22.6.2",
    "three": "0.179.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.179.0"
  }
}
