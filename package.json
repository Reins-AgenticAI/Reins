{
  "name": "reins",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "check": "pnpm lint && pnpm db:check && pnpm typecheck && pnpm test:coverage && pnpm build",
    "check:release": "pnpm check && pnpm db:migrate:test && pnpm test:integration",
    "db:check": "pnpm --filter @reins/db db:check",
    "db:down": "podman compose down",
    "db:generate": "pnpm --filter @reins/db db:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @reins/db db:migrate",
    "db:migrate:test": "dotenv -e .env.test -- pnpm --filter @reins/db db:migrate:test",
    "db:reset:test": "dotenv -e .env.test -- pnpm --filter @reins/db db:reset:test",
    "db:backup:test": "dotenv -e .env.test -- pnpm --filter @reins/db db:backup:test",
    "db:restore:test": "dotenv -e .env.test -- pnpm --filter @reins/db db:restore:test",
    "db:up": "podman compose up -d postgres",
    "db:up:test": "podman compose --profile test up -d postgres-test",
    "db:verify": "dotenv -e .env -- pnpm --filter @reins/db db:verify",
    "dev": "dotenv -e .env -- pnpm --parallel --filter @reins/web --filter @reins/api dev",
    "format": "biome check --write .",
    "eval:agents": "node scripts/run-parallel-spend-eval.mjs",
    "lint": "biome check .",
    "stripe:sandbox:verify": "dotenv -e .env -- tsx apps/web/scripts/verify-stripe-sandbox.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:coverage": "pnpm -r --workspace-concurrency=1 --if-present test:coverage",
    "test:integration": "dotenv -e .env.test -- pnpm -r --workspace-concurrency=1 --if-present test:integration",
    "test:integration:db": "dotenv -e .env.test -- pnpm --filter @reins/db test:integration",
    "test:unit": "pnpm -r --workspace-concurrency=1 --if-present test:unit",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.3",
    "@vitest/coverage-v8": "5.0.1",
    "dotenv-cli": "11.0.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
