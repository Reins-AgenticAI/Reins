{
  "name": "@reins/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:test": "tsx test/verify-target.ts && drizzle-kit migrate --config drizzle.config.ts",
    "db:reset:test": "tsx src/reset-test.ts",
    "db:backup:test": "tsx src/backup-test.ts",
    "db:restore:test": "tsx src/backup-test.ts --restore",
    "db:verify": "tsx src/verify.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:coverage": "vitest run --pool=threads --maxWorkers=1 --exclude \"**/*.integration.test.ts\" --coverage --coverage.include=src/**/*.ts --coverage.exclude=src/verify.ts --coverage.exclude=src/reset-test.ts --coverage.exclude=src/backup-test.ts --coverage.exclude=src/budget-reservations.ts --coverage.exclude=src/workflow-store.ts --coverage.exclude=src/decision-store.ts --coverage.exclude=src/evidence-store.ts --coverage.exclude=src/stripe-execution-store.ts --coverage.exclude=src/schema/** --coverage.reporter=text --coverage.reporter=json-summary --coverage.reportsDirectory=../../coverage/db --coverage.thresholds.statements=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.lines=90",
    "test:integration": "vitest run test --pool=threads --maxWorkers=1",
    "test:unit": "vitest run --pool=threads --maxWorkers=1 --exclude \"**/*.integration.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@reins/assurance": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "0.31.10"
  }
}
